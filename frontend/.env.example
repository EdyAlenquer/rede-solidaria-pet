# Base URL da API do backend.
# Em desenvolvimento com proxy do Vite, deixe vazio para usar /api/v1.
VITE_API_BASE_URL=/api/v1

# Analytics privacy-first (Plausible), opcional e desativado por padrão.
# Defina com o domínio registrado no Plausible para ativar o tracking
# (sem cookies, compatível com a LGPD). Deixe vazio/ausente para não rastrear.
# VITE_PLAUSIBLE_DOMAIN=seu-dominio.com.br
