# Backend — variáveis de ambiente
# Copie para .env e ajuste conforme necessário.

DATABASE_URL=sqlite:///./rede_solidaria_pet.db
APP_NAME=Rede Solidária Pet API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autenticação / JWT
# Em produção (APP_ENV=production) defina obrigatoriamente uma SECRET_KEY própria;
# o valor default abaixo é recusado fora de desenvolvimento.
SECRET_KEY=dev-insecure-troque-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Notificações ao protetor quando um atendimento é registrado
# NOTIFIER_BACKEND=log (default): apenas registra a notificação no log, sem enviar nada.
# NOTIFIER_BACKEND=smtp: envia e-mail; exige SMTP_HOST e SMTP_FROM (demais opcionais).
NOTIFIER_BACKEND=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alertas@example.com
# SMTP_TLS=true

# Storage das imagens enviadas
# STORAGE_BACKEND=local (default): grava em disco (UPLOAD_DIR), servido em
#   PUBLIC_UPLOAD_PATH. Em hosts efêmeros (ex.: Render free) os arquivos somem a
#   cada deploy/restart — use "s3" em produção.
# STORAGE_BACKEND=s3: grava em object storage S3-compatível (Cloudflare R2,
#   AWS S3, Supabase Storage, MinIO). Exige S3_BUCKET, S3_PUBLIC_BASE_URL e as
#   credenciais (S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY).
STORAGE_BACKEND=local
# UPLOAD_DIR=uploads
# PUBLIC_UPLOAD_PATH=/uploads
# MAX_UPLOAD_BYTES=5242880

# --- Object storage S3-compatível (usado quando STORAGE_BACKEND=s3) ---
# Nome do bucket onde os objetos são gravados.
# S3_BUCKET=rede-solidaria-pet
# Endpoint do serviço. Obrigatório para R2/MinIO/Supabase; vazio usa a AWS.
#   Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Região do bucket: "auto" no R2; região real na AWS (ex.: us-east-1).
# S3_REGION=auto
# Credenciais do token S3 (mantenha em segredo; nunca versione valores reais).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Base pública/CDN onde os objetos são servidos (prefixo das URLs salvas).
#   R2: https://pub-<HASH>.r2.dev  ou  um domínio próprio (ex.: https://fotos.seudominio.com)
# S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Prefixo (pseudo-pasta) das chaves dos objetos no bucket.
# S3_PREFIX=pedidos
